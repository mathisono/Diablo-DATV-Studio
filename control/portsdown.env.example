# Copy to /etc/portsdown/portsdown.env and replace each /absolute/path.
# Do not enable the services until the TX launcher and safe-off hook are
# verified with a dummy load. Leaving them unset makes START_TX fail closed.
PORTSDOWN_DIR=/absolute/path/to/portsdown4_NTSC
PORTSDOWN_CONFIG=/absolute/path/to/portsdown4_NTSC/scripts/portsdown_config.txt
PORTSDOWN_BOARD=express
# For an x86-64 host with a verified DTA-2145 and TSDuck DekTec plugin,
# select DEKTEC_ASI in the web UI and set PORTSDOWN_BOARD=dektec_asi.
# A finite-file validation launcher is control/dektec-asi-file.sh; it is NOT
# a verified live encoder. Set PORTSDOWN_ASI_TS_FILE to an analyzed TS file
# with any existing service_provider/service_name. The web GUI flags a
# mismatch, but does not block playout. TSDuck svrename applies saved labels
# in flight where possible; the source file is never rewritten.
# This launcher requires ffprobe and TSDuck tsp. Missing metadata does not
# block playout.
# The safe-off hook remains mandatory and must be verified on that host.
# PORTSDOWN_ASI_TS_FILE=/absolute/path/to/analyzed-sample.ts
PORTSDOWN_TX_EXEC=/absolute/path/to/verified/interlocked-tx-launcher
PORTSDOWN_SAFE_OFF_EXEC=/absolute/path/to/verified/board-safe-off-hook
PORTSDOWN_PREVIEW_EXEC=/absolute/path/to/portsdown4_NTSC/control/idle-preview.sh
# Non-HDMI standby source. When modeinput=HDMI, expresshdmidevice from the
# saved config is used instead; the web UI restarts preview after changing it.
PORTSDOWN_VIDEO_DEVICE=/dev/video0
# Optional if the HDMI capture device needs an explicit V4L2 format:
# PORTSDOWN_HDMI_INPUT_FORMAT=mjpeg
PORTSDOWN_HTTP_PORT=8080
# Only if using an authenticated reverse proxy, set its exact Host header:
# PORTSDOWN_ALLOWED_HOST=portsdown.example:443
PORTSDOWN_MJPEG_PORT=8082
# Optional five independent SRT -> source-resolution H.264/AAC TS encoders. They never
# feed RF directly; use the web UI to enable listeners as needed.
PORTSDOWN_SRT_EXEC=/absolute/path/to/portsdown4_NTSC/control/srt-slot.sh
PORTSDOWN_SRT_PORT_BASE=9101
PORTSDOWN_SRT_MJPEG_PORT_BASE=8083
PORTSDOWN_SRT_TS_PORT_BASE=12001
# PORTSDOWN_FFMPEG=/usr/bin/ffmpeg
PORTSDOWN_PEER_ROLE=STANDALONE
# For MASTER/SLAVE, also configure a private LAN/VPN and a strong token:
# PORTSDOWN_PEER_TOKEN=replace-with-long-random-token
# PORTSDOWN_PEER_HOST=remote-slave-address
# PORTSDOWN_PEER_BIND=private-interface-address
# PORTSDOWN_PEER_PORT=8181
# PORTSDOWN_SLAVE_PREVIEW_URL=https://private-slave.example/api/video
